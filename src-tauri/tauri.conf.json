{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokey",
  "version": "0.4.5",
  "identifier": "com.easykeys.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tokey · 本地 API Key 管理",
        "width": 360,
        "height": 250,
        "minWidth": 320,
        "minHeight": 220,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "本地 AI API Key 管理工具",
    "longDescription": "完全本地运行的 AI API Key 管理器：加密保险库存储、一键测速、明文/加密导出、一键写入环境变量。应用自身零联网。",
    "copyright": "Copyright © 2026 tokey",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 360
        },
        "appPosition": {
          "x": 140,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 400,
          "y": 180
        }
      }
    }
  }
}
